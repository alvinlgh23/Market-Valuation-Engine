{
  "_note": "AI model plan, phase A (CHAINSTOX_AI_MODELS_PLAN.md). Every role is off until the owner picks a model. Keys come only from environment variables or the git-ignored .env; never put a key in this file. Extraction keeps its own Gemini path in qualitative_evidence.py and is not configured here.",
  "providers": {
    "google": {"base_url": "https://generativelanguage.googleapis.com/v1beta/openai", "key_env": ["GEMINI_API_KEY", "GOOGLE_API_KEY"]},
