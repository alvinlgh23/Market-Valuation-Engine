    "groq": {"base_url": "https://api.groq.com/openai/v1", "key_env": ["GROQ_API_KEY"]}
  },
  "roles": {
    "review": {
      "enabled": false,
      "provider": "openrouter",
      "model": "",
      "timeout_seconds": 60,
      "daily_limit": 12,
      "fallback": []
    },
    "qa": {
      "enabled": false,
      "provider": "groq",
      "model": "",
      "timeout_seconds": 20,
      "daily_limit": 50,
      "fallback": [{"provider": "google", "model": ""}]
    }
  }
}
